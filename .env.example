# Modelo do arquivo de segredos. Copie para .env.local e preencha os valores.
# Este arquivo fica no repositório; o .env.local NÃO.

SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Assinatura da sessão (o login em si fica na tabela "usuarios" do banco).
# Gere o valor com: node scripts/gerar-senha.mjs
CRM_SEGREDO_SESSAO=

# Chave da API do Claude (Anthropic), para gerar os follow-ups.
# Pegue em console.anthropic.com > API keys. Começa com sk-ant-
ANTHROPIC_API_KEY=
